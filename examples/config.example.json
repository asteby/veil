{
  "ui": { "lang": "auto", "openBrowser": true, "ttlSeconds": 600 },
  "cacheTtlSeconds": 60,
  "defaultDestination": "local",
  "destinations": {
    "local": { "type": "keychain", "service": "veilform", "fallback": "ask" },
    "vault": { "type": "encrypted-file", "path": "~/.config/veil/data/secrets.enc", "key": { "source": "keychain" } },
    "dev-dotenv": { "type": "env-file", "path": "~/projects/myapp/.env" },
    "prod-env": { "type": "env-file", "host": "prod-vps", "path": "/etc/myapp/myapp.env", "owner": "app", "group": "app", "backup": true },
    "prod-files": { "type": "ssh-file", "host": "prod-vps", "path": "/etc/myapp/secrets/{name}", "mode": "0640", "owner": "root", "group": "app" },
    "infisical": {
      "type": "http-api", "adapter": "infisical", "baseUrl": "https://app.infisical.com",
      "auth": { "tokenRef": "local:infisical_token", "scheme": "bearer" },
      "options": { "workspaceId": "YOUR_WORKSPACE_ID", "environment": "prod", "secretPath": "/" }
    },
    "hashicorp": {
      "type": "http-api", "adapter": "vault-kv2", "baseUrl": "https://vault.example.com",
      "auth": { "tokenRef": "local:vault_token", "scheme": "header", "header": "X-Vault-Token" },
      "options": { "mount": "secret", "field": "value", "pathPrefix": "appdb/" }
    },
    "onepassword": {
      "type": "http-api", "adapter": "1password-connect", "baseUrl": "https://op-connect.example.com",
      "auth": { "tokenRef": "local:op_connect_token" },
      "options": { "vaultId": "YOUR_VAULT_ID", "field": "credential" }
    },
    "ops-mercadopago": {
      "type": "http-api", "adapter": "ops-addon-settings", "baseUrl": "https://panel.example.com",
      "auth": { "tokenRef": "local:ops_token" },
      "options": { "addon": "mercadopago", "keyMap": { "MP_ACCESS_TOKEN": "access_token" } }
    }
  },
  "ssh": {
    "hosts": {
      "prod-vps": { "host": "panel.example.com", "user": "deploy", "keyAlias": "deploy_key", "sudo": true }
    }
  },
  "writeTargets": [
    { "kind": "env-file", "host": "prod-vps", "path": "/etc/myapp/*.env", "keys": ["MP_*", "STRIPE_*"] },
    { "kind": "env-file", "path": "~/projects/**/.env" },
    { "kind": "json", "path": "~/projects/**/config/*.json" },
    { "kind": "systemd", "host": "prod-vps", "unit": "myapp.service", "keys": ["MP_*"] },
    { "kind": "github", "repo": "your-org/*", "keys": ["MP_*", "STRIPE_*"] },
    { "kind": "clipboard" }
  ],
  "http": { "allowedHosts": ["api.stripe.com", "api.mercadopago.com"] },
  "exec": { "defaultTimeoutMs": 60000, "maxOutputBytes": 65536, "allowShell": true, "redactEnvFiles": ["~/projects/myapp/.env"] },
  "databases": {
    "appdb": {
      "ssh": "prod-vps",
      "psql": ["sudo", "-u", "postgres", "psql", "-d", "appdb"],
      "tables": {
        "public.product_prices": { "columns": ["sku", "price_usd", "list"], "conflict": ["sku", "list"], "returning": "id" },
        "public.customers": { "columns": ["name", "email", "phone", "rfc"], "returning": "id" }
      },
      "maxRows": 5000
    }
  },
  "web": {
    "headless": false,
    "sessionTtlHours": 12,
    "sites": {
      "mercadopago": { "origins": ["https://www.mercadopago.com.mx", "https://*.mercadopago.com.mx", "https://www.mercadolibre.com"], "startUrl": "https://www.mercadopago.com.mx/developers/panel/app" },
      "stripe": { "origins": ["https://dashboard.stripe.com"], "startUrl": "https://dashboard.stripe.com/apikeys" }
    }
  },
  "ops": { "baseUrl": "https://panel.example.com", "tokenRef": "local:ops_token" },
  "localVault": { "unlockMinutes": 15 },
  "sync": {
    "targets": {
      "backup-dir": { "type": "dir", "path": "~/Backups/veil" },
      "r2": { "type": "s3", "endpoint": "https://YOUR_ACCOUNT.r2.cloudflarestorage.com", "bucket": "vault", "accessKeyRef": "R2_ID", "secretKeyRef": "R2_SECRET" },
      "repo": { "type": "git", "url": "git@github.com:your-org/vault-backup.git" }
    },
    "secondFactor": { "type": "key-file", "path": "~/.config/veil/sync.key" },
    "shareTarget": "r2",
    "unlockMinutes": 10
  },
  "env": {
    "files": ["~/projects/**/.env", "~/projects/**/.env.*"],
    "keyFiles": ["~/.config/veil/keys/myapp.key"]
  }
}
